    "id": "legacy.jobs.30",
    "kind": "dialogue",
    "variants": [
      {
        "language": "pl",
        "localHumor": false,
        "text": "„Profesor z towarzystwa naukowego prosi o pomoc: potrzebujemy zbadać drogę do miejscowości {cel} (ok. {km} km w linii prostej). Dotrzyj tam i wróć – zapłacimy za każdy kilometr!”"
      },
      {
        "language": "en",
        "localHumor": false,
        "text": "“A professor from the learned society needs help surveying the route to {cel}, about {km} km in a straight line. Get there and return; we pay for every kilometre!”"
      }
    ]
