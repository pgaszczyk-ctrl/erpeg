      {
        "language": "en",
        "localHumor": false,
        "text": "The librarian unfolds an old map. “Our learned society is making an atlas of the surrounding area. We are missing the route to {cel}, about {km} km away. Travel there, remember the route and bring back a report!”"
      }
    ]
