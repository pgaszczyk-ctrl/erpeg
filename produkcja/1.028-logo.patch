+export function logoTekst(width = 300, className = 'm-logo-tekst'): HTMLImageElement {
+  const img = document.createElement('img');
+  img.src = `${import.meta.env.BASE_URL}logo-tekst.webp`;
+  img.alt = GAME_NAME;
+  img.width = width;
+  img.height = Math.round((width * 230) / 760);
+  img.className = className;
+  return img;
+}
